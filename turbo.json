{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": ["DATABASE_URL", "WEBMCP_CAFE_API_URL", "WEBMCP_CAFE_API_KEY"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", ".output/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "test": {
      "dependsOn": ["^build"]
    }
  }
}
