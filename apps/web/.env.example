# Neon Postgres connection string (Robert creates the Neon project)
DATABASE_URL="postgres://user:password@host/db?sslmode=require"

# GitHub OAuth app (callback: {BETTER_AUTH_URL}/api/auth/callback/github)
GITHUB_CLIENT_ID="replace-me"
GITHUB_CLIENT_SECRET="replace-me"

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-32-plus-chars"

BETTER_AUTH_URL="http://localhost:3000"

# Comma-separated extension IDs the package-page install button probes
# (dev-key ID first, CWS-assigned ID once the extension is published).
# Optional — unset means the button always shows "Install the extension".
NEXT_PUBLIC_WEBMCP_EXTENSION_IDS=""

# Sentry error monitoring. Optional — unset disables the SDK entirely
# (no events sent), so outside contributors don't need a Sentry project.
NEXT_PUBLIC_SENTRY_DSN=""

# Source-map upload at build time (maintainers only). These live in the
# gitignored .env.sentry-build-plugin locally and in Vercel env for CI:
# SENTRY_AUTH_TOKEN, SENTRY_ORG, SENTRY_PROJECT
