{
  "domain": "npmjs.com",
  "urlPatterns": ["*://*.npmjs.com/package/*"],
  "title": "npm package page",
  "description": "Read-only tools for npm package pages: read the README and search the registry.",
  "tools": [
    {
      "name": "npm_read_readme",
      "description": "Read the README of the npm package page currently open.",
      "inputSchema": { "type": "object", "properties": {} },
      "annotations": { "readOnlyHint": true },
      "execution": {
        "selector": "body",
        "autosubmit": false,
        "resultSelector": "#readme",
        "resultExtract": "text"
      }
    },
    {
      "name": "npm_search",
      "description": "Search the npm registry. Navigates to the npm search results page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Search query" }
        },
        "required": ["query"]
      },
      "annotations": { "readOnlyHint": true },
      "execution": {
        "selector": "body",
        "autosubmit": false,
        "steps": [{ "action": "navigate", "url": "https://www.npmjs.com/search?q={{query}}" }]
      }
    }
  ]
}
