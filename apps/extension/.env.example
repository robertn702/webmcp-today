# Registry origin the background script POLLS (revocations feed only — page
# loads resolve from local storage and never fetch). WXT inlines any
# WXT_-prefixed var into import.meta.env at build time. Defaults to
# https://webmcp.cafe in code if unset.
WXT_REGISTRY_API_URL="http://localhost:3000"

# Dev extension key — pins the extension ID across rebuilds so the registry
# site's NEXT_PUBLIC_WEBMCP_EXTENSION_IDS stays valid. Generate once per
# machine (see apps/extension/AGENTS.md "Dev extension key"); NEVER commit
# key.pem or the key value. Optional: unset means Chrome assigns a random ID
# per profile.
WXT_EXTENSION_KEY=""
