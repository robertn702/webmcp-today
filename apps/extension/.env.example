# Registry origin the background script POLLS (revocations feed only — page
# loads resolve from local storage and never fetch). WXT inlines any
# WXT_-prefixed var into import.meta.env at build time. Defaults to
# https://webmcp.today in code if unset.
WXT_REGISTRY_API_URL="http://localhost:3000"

# Local builds use the committed development public key, so no extension-key
# setup is needed. WXT_EXTENSION_KEY overrides it only for a distinct build
# identity, such as the release CI key. Never put a private PEM in this file.
# WXT_EXTENSION_KEY=""
