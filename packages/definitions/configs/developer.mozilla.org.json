{
  "domain": "developer.mozilla.org",
  "urlPatterns": ["*://developer.mozilla.org/*"],
  "title": "MDN Web Docs",
  "description": "Read-only tools for MDN: extract the current page's headings and article text, and search MDN.",
  "tools": [
    {
      "name": "mdn_list_headings",
      "description": "List the section headings of the MDN page currently open.",
      "inputSchema": { "type": "object", "properties": {} },
      "annotations": { "readOnlyHint": true },
      "execution": {
        "mode": "dom",
        "selector": "body",
        "autosubmit": false,
        "resultSelector": "article h2, article h3",
        "resultExtract": "list"
      }
    },
    {
      "name": "mdn_read_article",
      "description": "Extract the text content of the MDN article currently open.",
      "inputSchema": { "type": "object", "properties": {} },
      "annotations": { "readOnlyHint": true },
      "execution": {
        "mode": "dom",
        "selector": "body",
        "autosubmit": false,
        "resultSelector": "article",
        "resultExtract": "text"
      }
    },
    {
      "name": "mdn_search",
      "description": "Search MDN Web Docs. Navigates to the MDN search results page.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": { "type": "string", "description": "Search query" }
        },
        "required": ["query"]
      },
      "annotations": { "readOnlyHint": true },
      "execution": {
        "mode": "dom",
        "selector": "body",
        "autosubmit": false,
        "steps": [
          {
            "action": "navigate",
            "url": "https://developer.mozilla.org/en-US/search?q={{query}}"
          }
        ]
      }
    }
  ]
}
