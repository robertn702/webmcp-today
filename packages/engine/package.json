{
  "name": "@robertn702/webmcp-today-engine",
  "version": "0.1.0",
  "description": "Execution engine for WebMCP Today — runs a package's declarative api block as HTTP requests",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertn702/webmcp-today.git",
    "directory": "packages/engine"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jmespath-community/jmespath": "1.3.0",
    "@robertn702/webmcp-today-schema": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
