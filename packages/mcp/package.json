{
  "name": "@robertn702/webmcp-today-mcp",
  "version": "0.1.0",
  "description": "MCP server for the WebMCP Today registry and local browser bridge — manage packages and list or execute live WebMCP tools",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/robertn702/webmcp-today.git",
    "directory": "packages/mcp"
  },
  "bin": {
    "webmcp-today-mcp": "./dist/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json && node scripts/bundle-native-host.mjs",
    "typecheck": "tsc --noEmit",
    "test": "bun run build && vitest run"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.17.0",
    "@robertn702/webmcp-today-schema": "workspace:*",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22",
    "esbuild": "^0.25.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
